apt install mesa-common-dev
apt install libopenal-dev
apt install libpulse-dev
apt install libudev-dev
apt install libxcb-xinput-dev && apt install libxcb-xfixes0
---------------------------------------------
ARCH (Manjaro, Endeavour, ...)
---------------------------------------------
pacman -Sy gcc
pacman -Sy make
pacman -Sy gtk3
pacman -Sy pkgconf
---------------------------------------------
RPM (Fedora, SUSE, ...)
---------------------------------------------
dnf install freetype-devel
dnf install openal-soft-devel
dnf install pulseaudio-libs-devel
dnf install gtk3-devel
dnf install libgudev-devel
---------------------------------------------
Gentoo
---------------------------------------------
emerge --ask dev-vcs/git
emerge --ask cmake
emerge --ask media-libs/openal
emerge --ask media-sound/pulseaudio
---------------------------------------------
FreeBSD (GhostBSD)
---------------------------------------------
pkg install cmake
pkg install os-generic-userland-devtools    (GhostBSD)
pkg install pkgconf
pkg install openal-soft
pkg install pulseaudio
---------------------------------------------
NetBSD
---------------------------------------------
pkgin in cmake
pkgin in pkg-config
pkgin in openal-soft
pkgin in pulseaudio
---------------------------------------------
OpenBSD
---------------------------------------------
pkg_add openal
pkg_add pulseaudio
pkg_add gtk+3

----------------------------------------------
ALL: GET, CONFIGURE, BUILD AND INSTALL DENISE
----------------------------------------------
git clone https://piciji@bitbucket.org/piciji/denise.git denise
cd denise
cmake -B builds/release
cmake --build builds/release -j 8
sudo cmake --build builds/release --target install

----------------------------------------------
UPDATES: repeat it from time to time
----------------------------------------------
cd denise
git pull
cmake --build builds/release -j 8
sudo cmake --build builds/release --target install

----------------------------------------------
UNINSTALL
----------------------------------------------
sudo cmake --build builds/release --target uninstall

----------------------------------------------
OPTIONAL: build and install denise locally without sudo privileges
----------------------------------------------
cmake --build builds/release --target clean
cmake -B builds/release -DCMAKE_INSTALL_PREFIX=~/.local
cmake --build builds/release -j 8
cmake --build builds/release --target install
