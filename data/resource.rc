#include <windows.h>
#include "resource.h"

1 24 "denise.Manifest"
2 ICON DISCARDABLE "img/denise.ico"

IDD_FILE_TEMPLATE DIALOG DISCARDABLE 0, 0, 486, 205
STYLE WS_CHILD | WS_CLIPSIBLINGS | DS_3DLOOK | DS_CONTROL | WS_VISIBLE | NOT WS_BORDER | NOT WS_POPUP | NOT WS_SYSMENU
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT      "",IDC_FRAME,0,5,260,180 
    LISTBOX    IDC_LIST, 270,5,210,150, WS_BORDER | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON "", IDC_BUTTON, 269,160,70,14, WS_TABSTOP
END
