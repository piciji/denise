#include <windows.h>
#include "resource.h"

#ifndef ID_MANIFEST
#define ID_MANIFEST 101
#endif

ID_MANIFEST RT_MANIFEST "denise.Manifest"
ID_ICON ICON DISCARDABLE "img/denise.ico"

IDD_FILE_TEMPLATE DIALOG DISCARDABLE 0, 0, 486, 205
STYLE WS_CHILD | WS_CLIPSIBLINGS | DS_3DLOOK | DS_CONTROL | WS_VISIBLE | NOT WS_BORDER | NOT WS_POPUP | NOT WS_SYSMENU
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT      "",IDC_FRAME,0,5,260,180 
    LISTBOX    IDC_LIST, 270,5,210,150, WS_BORDER | LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON "", IDC_BUTTON, 269,160, 70,14, WS_TABSTOP
    PUSHBUTTON "", IDC_BUTTON1, 330,160,70,14, WS_TABSTOP
    PUSHBUTTON "", IDC_BUTTON2, 400,160,0,14, WS_TABSTOP
    AUTOCHECKBOX "", IDC_CHECKBOX, 269, 160, 0, 14, WS_TABSTOP
END
