FIND_PATH(LIBLAME_INCLUDE_DIRS lame/lame.h)
FIND_LIBRARY(LIBLAME_LIBRARIES NAMES mp3lame)

IF(LIBLAME_INCLUDE_DIRS AND LIBLAME_LIBRARIES)
	SET(LIBLAME_FOUND TRUE)
ENDIF(LIBLAME_INCLUDE_DIRS AND LIBLAME_LIBRARIES)

IF(LIBLAME_FOUND)
	IF (NOT Lame_FIND_QUIETLY)
		MESSAGE(STATUS "Found LAME: ${LIBLAME_LIBRARIES}")
	ENDIF (NOT Lame_FIND_QUIETLY)
ELSE(LIBLAME_FOUND)
	IF (Lame_FIND_REQUIRED)
		MESSAGE(FATAL_ERROR "Could NOT find lame development files")
	ELSE (Lame_FIND_REQUIRED)
		MESSAGE(STATUS "Could NOT find LAME")
	ENDIF (Lame_FIND_REQUIRED)
ENDIF(LIBLAME_FOUND)
